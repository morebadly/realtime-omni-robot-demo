{
  "name": "realtime-omni-robot-demo",
  "version": "1.3.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "verify": "npm run build && npm run test:version-doctor && npm run test:localdev-adapter-contract && npm run test:realtime-readiness && npm run test:localdev-preflight && npm run test:smoke",
    "verify:quick": "npm run build && npm run test:version-doctor && npm run test:localdev-adapter-contract && npm run test:realtime-readiness && npm run test:localdev-preflight",
    "clean": "node scripts/clean-local-artifacts.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "mock:localdev": "node scripts/localdev-omni-mock-server.mjs",
    "adapter:localdev:skeleton": "node scripts/localdev-omni-adapter-skeleton.mjs",
    "adapter:localdev:qwen-omni": "powershell -NoProfile -Command \"$env:LOCALDEV_OMNI_PROVIDER='qwen_omni'; node scripts/localdev-omni-adapter-skeleton.mjs\"",
    "adapter:localdev:qwen-stub": "powershell -NoProfile -Command \"$env:LOCALDEV_OMNI_PROVIDER='qwen_stub'; node scripts/localdev-omni-adapter-skeleton.mjs\"",
    "adapter:localdev:qwen-omni-loopback": "powershell -NoProfile -Command \"$env:LOCALDEV_OMNI_PROVIDER='qwen_omni'; $env:LOCALDEV_QWEN_DRY_RUN='0'; $env:LOCALDEV_QWEN_TRANSPORT='loopback'; $env:LOCALDEV_QWEN_ENDPOINT='loopback://local'; node scripts/localdev-omni-adapter-skeleton.mjs\"",
    "adapter:localdev:qwen-loopback": "powershell -NoProfile -Command \"$env:LOCALDEV_OMNI_PROVIDER='qwen_stub'; $env:LOCALDEV_QWEN_DRY_RUN='0'; $env:LOCALDEV_QWEN_TRANSPORT='loopback'; $env:LOCALDEV_QWEN_ENDPOINT='loopback://local'; node scripts/localdev-omni-adapter-skeleton.mjs\"",
    "service:localdev:qwen-template": "node scripts/localdev-qwen-service-template.mjs",
    "adapter:localdev:qwen-websocket-template": "powershell -NoProfile -Command \"$env:LOCALDEV_OMNI_PROVIDER='qwen_stub'; $env:LOCALDEV_QWEN_DRY_RUN='0'; $env:LOCALDEV_QWEN_TRANSPORT='websocket_json'; $env:LOCALDEV_QWEN_ENDPOINT='ws://127.0.0.1:8010/qwen/realtime'; node scripts/localdev-omni-adapter-skeleton.mjs\"",
    "adapter:localdev:qwen-omni-websocket-template": "powershell -NoProfile -Command \"$env:LOCALDEV_OMNI_PROVIDER='qwen_omni'; $env:LOCALDEV_QWEN_DRY_RUN='0'; $env:LOCALDEV_QWEN_TRANSPORT='websocket_json'; $env:LOCALDEV_QWEN_ENDPOINT='ws://127.0.0.1:8010/qwen/realtime'; node scripts/localdev-omni-adapter-skeleton.mjs\"",
    "health:localdev": "node scripts/localdev-health-check.mjs",
    "health:localdev:adapter": "node scripts/localdev-health-check.mjs adapter",
    "health:localdev:qwen": "node scripts/localdev-health-check.mjs qwen",
    "health:dashscope-omni": "node scripts/dashscope-omni-realtime-health.mjs",
    "test:localdev-adapter-contract": "node scripts/localdev-adapter-contract-smoke.mjs",
    "test:localdev-contract-matrix": "node scripts/localdev-contract-matrix-smoke.mjs",
    "test:localdev-adapter-contract:qwen-loopback": "powershell -NoProfile -Command \"$env:LOCALDEV_CONTRACT_PROVIDER='qwen_stub'; $env:LOCALDEV_CONTRACT_SCENARIO='qwen_loopback'; $env:LOCALDEV_QWEN_DRY_RUN='0'; $env:LOCALDEV_QWEN_TRANSPORT='loopback'; $env:LOCALDEV_QWEN_ENDPOINT='loopback://local'; node scripts/localdev-adapter-contract-smoke.mjs\"",
    "test:localdev-adapter-contract:qwen-omni-loopback": "powershell -NoProfile -Command \"$env:LOCALDEV_CONTRACT_PROVIDER='qwen_omni'; $env:LOCALDEV_CONTRACT_SCENARIO='qwen_loopback'; $env:LOCALDEV_QWEN_DRY_RUN='0'; $env:LOCALDEV_QWEN_TRANSPORT='loopback'; $env:LOCALDEV_QWEN_ENDPOINT='loopback://local'; node scripts/localdev-adapter-contract-smoke.mjs\"",
    "test:localdev-adapter-contract:qwen-websocket": "powershell -NoProfile -Command \"$env:LOCALDEV_CONTRACT_PROVIDER='qwen_stub'; $env:LOCALDEV_CONTRACT_SCENARIO='qwen_websocket'; node scripts/localdev-adapter-contract-smoke.mjs\"",
    "test:localdev-adapter-contract:qwen-template": "powershell -NoProfile -Command \"$env:LOCALDEV_CONTRACT_PROVIDER='qwen_stub'; $env:LOCALDEV_CONTRACT_SCENARIO='qwen_template_service'; node scripts/localdev-adapter-contract-smoke.mjs\"",
    "test:localdev-adapter-contract:qwen-omni-template": "powershell -NoProfile -Command \"$env:LOCALDEV_CONTRACT_PROVIDER='qwen_omni'; $env:LOCALDEV_CONTRACT_SCENARIO='qwen_template_service'; node scripts/localdev-adapter-contract-smoke.mjs\"",
    "test:localdev-qwen-transport": "node scripts/localdev-qwen-realtime-transport-smoke.mjs",
    "test:media-channel-ack": "node scripts/media-channel-ack-smoke.mjs",
    "test:realtime-readiness": "node scripts/realtime-readiness-smoke.mjs",
    "test:connection-modes": "node scripts/connection-modes-smoke.mjs",
    "test:network-manager": "node scripts/network-manager-smoke.mjs",
    "test:connection-status-view-model": "node scripts/connection-status-view-model-smoke.mjs",
    "test:connection-manager-view-model": "node scripts/connection-manager-view-model-smoke.mjs",
    "test:localdev-preflight": "node scripts/localdev-preflight-smoke.mjs",
    "test:localdev-qwen-config": "node scripts/localdev-qwen-config-smoke.mjs",
    "test:localdev-reconnect-recovery": "node scripts/localdev-reconnect-recovery-smoke.mjs",
    "test:provider-config-gate": "node scripts/provider-config-gate-smoke.mjs",
    "test:provider-health-check": "node scripts/provider-health-check-smoke.mjs",
    "test:provider-handshake": "node scripts/provider-handshake-smoke.mjs",
    "test:provider-audio-gate": "node scripts/provider-audio-gate-smoke.mjs",
    "test:provider-camera-gate": "node scripts/provider-camera-gate-smoke.mjs",
    "test:realtime-output-queue": "node scripts/realtime-output-queue-smoke.mjs",
    "test:dashscope-omni-config": "node scripts/dashscope-omni-realtime-config-smoke.mjs",
    "test:localdev-provider-registry": "node scripts/localdev-provider-registry-smoke.mjs",
    "test:version-doctor": "node scripts/version-doctor.mjs",
    "test:smoke": "node scripts/run-smoke-suite.mjs"
  },
  "dependencies": {
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest",
    "ws": "latest"
  },
  "devDependencies": {}
}
